PORT=5000
MONGODB_URI=mongodb://localhost:27017/tainzay
NODE_ENV=development

# ─── Order notifications ───────────────────────────────────────────────────────
BRAND_NAME=Tainzay
EMAIL_FROM_NAME=Tainzay

# Email — pick ONE provider:

# Option A: Resend (easiest — https://resend.com)
RESEND_API_KEY=
RESEND_FROM=orders@tainzay.com

# Option B: SMTP (Gmail, Outlook, cPanel, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@tainzay.com

# WhatsApp — pick ONE provider:

# Option A: Meta WhatsApp Cloud API (recommended)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Option B: Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option C: CallMeBot (free; order alerts to the store's own WhatsApp number only)
# From the store's WhatsApp, follow the signup steps on callmebot.com to get a key.
CALLMEBOT_API_KEY=

# Test: npm run test:notifications you@email.com 03001234567
TEST_NOTIFICATION_EMAIL=
TEST_NOTIFICATION_PHONE=
